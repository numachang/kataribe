{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウに許可する権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "allow-load-settings",
    "allow-save-settings",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-list-models",
    "allow-list-genres",
    "allow-create-project",
    "allow-open-project",
    "allow-close-project",
    "allow-overview",
    "allow-pipeline",
    "allow-read-file",
    "allow-write-file",
    "allow-text-stats",
    "allow-parse-ruby",
    "allow-analyze-quality",
    "allow-generate",
    "allow-cancel-generation",
    "allow-apply-change-set"
  ]
}
